syntax = "v1"

@server (
	group: dashboard
	middleware: Jwt,ActionLog,Authority
	prefix: /dashboard
)
service operator_report {
	// 会员增长趋势
	@handler GetMemberGrowthTrend
	post /get-member-growth-trend (MemberGrowthTrendRequest) returns (MemberGrowthTrendResponse)
	
	// 会员概览（总数、新增、活跃等）
	@handler GetMemberSummary
	get /get-member-summary (MemberSummaryRequest) returns (MemberSummaryResponse)
}

// ============================================================================
// 会员增长趋势
// ============================================================================

type GrowthTrendStatItem {
	Date  string `json:"date"`  // 日期或小时 (YYYY-MM-DD 或 YYYY-MM-DD HH:00)
	Count int64  `json:"count"` // 统计数量 (根据type字段表示：新增数、登录数、或留存率*100)
}

type MemberGrowthTrendRequest {
	StartDate   string `json:"start_date"`   // 开始日期 (YYYY-MM-DD)
	EndDate     string `json:"end_date"`     // 结束日期 (YYYY-MM-DD)
	Granularity string `json:"granularity"`  // 统计粒度: day、hour
	AgentId     string `json:"agent_id,optional"`     // 代理ID (可选，不传则统计整个分站)
	Source      string `json:"source,optional"`       // 来源过滤 (可选)
	Type        string `json:"type"`         // 统计类型: register(注册数)、login(登录数)、retention(留存率)
}

type MemberGrowthTrendResponse {
	Code    int64                  `json:"code"`    // 0=成功，非0=失败
	Message string                 `json:"message"` // 错误信息
	List    []GrowthTrendStatItem  `json:"list"`    // 统计结果列表
}

// ============================================================================
// 会员概览
// ============================================================================

type MemberSummaryRequest {
	AgentId string `json:"agent_id,optional"` // 代理ID (可选，不传则统计整个分站)
}

type MemberSummary {
	TotalMembers             int64   `json:"total_members"`              // 会员总数
	MembersGrowthRate        float64 `json:"members_growth_rate"`        // 较昨日会员总数上涨比例 (%)
	TodayNewMembers          int64   `json:"today_new_members"`          // 今日新增（今日注册）
	Last24HNewMembers        int64   `json:"last_24h_new_members"`       // 过去24小时新增
	Last24HNewGrowthRate     float64 `json:"last_24h_new_growth_rate"`   // 过去24小时较前24小时新增增长比例 (%)
	TodayDepositAmount       int64   `json:"today_deposit_amount"`       // 今日充值金额（单位：元）
	DepositGrowthRate        float64 `json:"deposit_growth_rate"`        // 充值增长比例 (%)
	ActiveMembers            int64   `json:"active_members"`             // 活跃会员总数
	TodayActiveMembers       int64   `json:"today_active_members"`       // 今日活跃会员数
	Last24HActiveMembers     int64   `json:"last_24h_active_members"`    // 过去24小时活跃会员数
	Last24HActiveGrowthRate  float64 `json:"last_24h_active_growth_rate"` // 过去24小时较前24小时活跃增长比例 (%)
}

type MemberSummaryResponse {
	Code    int64          `json:"code"`    // 0=成功，非0=失败
	Message string         `json:"message"` // 错误信息
	Data    MemberSummary  `json:"data"`    // 会员概览数据
}
