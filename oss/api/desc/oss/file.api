syntax = "v1"

info (
	title:   "file archive api"
	desc:    "oss_file list and delete"
	author:  "p9"
	version: "v1"
)

import "../base.api"

type FileListReq {
	Scene    string `json:"scene,optional"`
	Page     int    `json:"page,optional"`
	PageSize int    `json:"page_size,optional"`
}

type FileInfo {
	Id           uint64 `json:"id"`
	Key          string `json:"key"`
	Scene        string `json:"scene"`
	Bucket       string `json:"bucket"`
	Name         string `json:"name"`
	Size         int64  `json:"size"`
	ContentType  string `json:"content_type"`
	Url          string `json:"url"`
	Visibility   string `json:"visibility,optional"`
	UrlExpiresIn int    `json:"url_expires_in,optional"`
	CreatedAt    int64  `json:"created_at"`
}

type FileListData {
	List  []FileInfo `json:"list"`
	Total int64      `json:"total"`
}

type FileDeleteReq {
	Key string `json:"key"`
}

@server (
	prefix:     /p9/oss
	group:      file
	middleware: Jwt,ActionLog,Authority
)
service Oss {
	@handler list
	post /file/list (FileListReq) returns (FileListData)

	@handler delete
	post /file/delete (FileDeleteReq) returns (FileData)
}
