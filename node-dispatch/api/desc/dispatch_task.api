syntax = "v1"

import "types/common.api"

type (
	// 调度任务信息
	DispatchTaskInfo {
		// 调度中心生成的任务编号
		TaskNo string `json:"task_no"`
		// 调用方生成的请求编号
		RequestNo string `json:"request_no"`
		// 任务目标服务
		Target string `json:"target"`
		// 任务类型
		TaskType string `json:"task_type"`
		// 任务参数, JSON数据
		Params string `json:"params"`
		// 执行节点编码
		NodeCode string `json:"node_code"`
		// 任务状态: 1待执行, 2执行中, 3成功, 4失败
		Status int64 `json:"status"`
		// 任务执行结果, JSON数据
		Result *string `json:"result,optional"`
		// 任务执行失败原因
		ErrorMessage *string `json:"error_message,optional"`
		// 开始执行时间, Unix毫秒时间戳
		StartedAt *int64 `json:"started_at,optional"`
		// 执行结束时间, Unix毫秒时间戳
		FinishedAt *int64 `json:"finished_at,optional"`
		// 创建时间, Unix毫秒时间戳
		CreatedAt int64 `json:"created_at"`
		// 更新时间, Unix毫秒时间戳
		UpdatedAt int64 `json:"updated_at"`
	}
	// 获取调度任务请求
	GetDispatchTaskRequest {
		// 调度任务编号
		TaskNo string `form:"task_no" validate:"required,notblank,max=64"`
	}
	// 获取调度任务响应
	GetDispatchTaskResponse {
		// 调度任务信息
		DispatchTaskInfo
	}
	// 获取调度任务列表请求
	ListDispatchTasksRequest {
		// 分页参数
		PageRequest
		// 搜索关键字, 匹配任务编号或请求编号
		Keyword *string `form:"keyword,optional" validate:"omitempty,max=64"`
		// 任务类型
		TaskType *string `form:"task_type,optional" validate:"omitempty,max=64"`
		// 任务状态: 1待执行, 2执行中, 3成功, 4失败
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2 3 4"`
		// 执行节点编码
		NodeCode *string `form:"node_code,optional" validate:"omitempty,max=64"`
	}
	// 获取调度任务列表响应
	ListDispatchTasksResponse {
		// 数据总数
		Total int64 `json:"total"`
		// 调度任务列表
		List []DispatchTaskInfo `json:"list"`
	}
)

@server (
	group:      dispatch_task
	prefix:     /admin/dispatch-task
	middleware: Jwt,ActionLog,Authority
)
service node_dispatch {
	// 获取调度任务
	@handler GetDispatchTask
	get /get (GetDispatchTaskRequest) returns (GetDispatchTaskResponse)

	// 获取调度任务列表
	@handler ListDispatchTasks
	get /list (ListDispatchTasksRequest) returns (ListDispatchTasksResponse)
}

