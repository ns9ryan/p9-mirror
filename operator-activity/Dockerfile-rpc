FROM alpine:3.22

ARG AUTHOR="p9.work@gmail.com"
LABEL org.opencontainers.image.authors=${AUTHOR}

WORKDIR /app

# 设置容器时区并安装运行依赖
ENV TZ=Asia/Shanghai
RUN apk add --no-cache tzdata ca-certificates

# 复制 RPC 程序及配置文件
COPY ./operator_activity_rpc ./operator_activity_rpc
COPY ./etc/operator_activity.yaml ./etc/operator_activity.yaml
RUN chmod +x ./operator_activity_rpc

EXPOSE 39006

ENTRYPOINT ["./operator_activity_rpc"]
CMD ["-f", "etc/operator_activity.yaml"]
