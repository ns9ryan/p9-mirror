FROM alpine:3.22

ARG PROJECT=integration
ARG CONFIG_FILE=integration.yaml
ARG AUTHOR="p9.work@gmail.com"

LABEL org.opencontainers.image.authors=${AUTHOR}

WORKDIR /app
ENV PROJECT=${PROJECT}
ENV CONFIG_FILE=${CONFIG_FILE}
ENV TZ=Asia/Shanghai

RUN apk update --no-cache && apk add --no-cache tzdata

COPY ./${PROJECT}_rpc ./
COPY ./rpc/etc/${CONFIG_FILE} ./etc/

EXPOSE 19005

ENTRYPOINT ["./integration_rpc", "-f", "etc/integration.yaml"]
