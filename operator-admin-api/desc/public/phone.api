syntax = "v1"

info (
	title:   "phone calling codes api"
	desc:    "手机区号"
	author:  "p9"
	version: "v1"
)

type PhoneCallingCodeItem {
	// Region | ISO 3166-1 alpha-2
	Region string `json:"region"`
	// Code | 国际区号，不含加号
	Code string `json:"code"`
	// Min | 国内号码最小位数
	Min int32
	// Max | 国内号码最大位数
	Max int32
}

type ListPhoneCallingCodesResp {
	List []PhoneCallingCodeItem `json:"list"`
}

@server (
	group:      public/phone
	middleware: Jwt
)
service operator_admin_api {
	@doc "手机区号列表"
	@handler listPhoneCallingCodes
	get /phone-calling-codes returns (ListPhoneCallingCodesResp)
}

