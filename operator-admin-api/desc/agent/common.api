syntax = "v1"

info (
	title:   "agent common types"
	desc:    "代理模块共享类型"
	author:  "p9"
	version: "v1"
)

// Agent level item | 代理等级项
type AgentLevelItem {
	Id    int64  `json:"id,optional"`
	Level int32  `json:"level"`
	Name  string `json:"name"`
	Alias string `json:"alias"`
}

// Agent config | 代理配置
type AgentConfig {
	Id                    int64 `json:"id,optional"`
	MaxShareRate          int32 `json:"max_share_rate"`
	ApplyMinShareRate     int32 `json:"apply_min_share_rate"`
	ApplyMaxShareRate     int32 `json:"apply_max_share_rate"`
	CashMaxMemberCount    int64 `json:"cash_max_member_count"`
	CashMaxAgentPerIp     int64 `json:"cash_max_agent_per_ip"`
	CashProductionAgentId int64 `json:"cash_production_agent_id,optional"`
	CashDemoAgentId       int64 `json:"cash_demo_agent_id,optional"`
	CashTestAgentId       int64 `json:"cash_test_agent_id,optional"`
	CreditDemoAgentId     int64 `json:"credit_demo_agent_id,optional"`
	CreditTestAgentId     int64 `json:"credit_test_agent_id,optional"`
}

// Agent create fields | 创建代理字段
type AgentCreateFields {
	Account       string `json:"account"`
	Code          string `json:"code,optional"`
	Password      string `json:"password"`
	AgentType     int32  `json:"agent_type"`
	AgentLineCode string `json:"agent_line_code,optional"`
	ShareRate     int32  `json:"share_rate"`
	PromoCode     string `json:"promo_code,optional"`
	RegisterIp    string `json:"register_ip,optional"`
	Remark 		  string `json:"remark,optional"`
}

// Add agent response | 添加代理响应
type AddAgentResp {
	Id        int64  `json:"id"`
	Account   string `json:"account"`
	Code      string `json:"code"`
	ParentId  int64  `json:"parent_id"`
	TopId     int64  `json:"top_id"`
	Level     int32  `json:"level"`
	ShareRate int32  `json:"share_rate"`
}

// Agent search item | 搜索代理项
type AgentSearchItem {
	Id         int64  `json:"id"`
	Account    string `json:"account"`
	Level      int32  `json:"level"`
	LevelAlias string `json:"level_alias"`
	LineCode   string `json:"line_code"`
	ShareRate  int32  `json:"share_rate"`
}

// Agent list item | 代理列表项
type AgentListItem {
	Id                int64  `json:"id"`
	Account           string `json:"account"`
	Level             int32  `json:"level"`
	LevelAlias        string `json:"level_alias"`
	ParentId          int64  `json:"parent_id"`
	ParentAccount     string `json:"parent_account"`
	TopId             int64  `json:"top_id"`
	TopAccount        string `json:"top_account"`
	RegisterSource    int32  `json:"register_source"`
	DirectMemberCount int64  `json:"direct_member_count"`
	DirectAgentCount  int64  `json:"direct_agent_count"`
	TotalMemberCount  int64  `json:"total_member_count"`
	TotalAgentCount   int64  `json:"total_agent_count"`
	ShareRate         int32  `json:"share_rate"`
	WalletBalance     int64  `json:"wallet_balance"`
	TotalCommission   int64  `json:"total_commission"`
	UnpaidCommission  int64  `json:"unpaid_commission"`
	Status            int32  `json:"status"`
	PayoutRestricted  int32  `json:"payout_restricted"`
	Remark            string `json:"remark"`
	PromoLink         string `json:"promo_link"`
	VisitUv           int64  `json:"visit_uv"`
	RegisterAt        int64  `json:"register_at"`
	LastLoginAt       int64  `json:"last_login_at"`
}

