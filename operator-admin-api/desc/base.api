syntax = "v1"

info (
	title:   "base api"
	desc:    "shared types for operator-admin-api"
	author:  "p9"
	version: "v1"
)

// IDs request | ID 列表
type IDsReq {
	// ID | 单个ID
	Id  int64   `json:"id,optional"`
	// IDs | ID列表
	Ids []int64 `json:"ids,optional"`
}

// Page request | 分页
type PageReq {
	// Page | 页码
	Page     int32 `json:"page,optional"`
	// Page size | 每页条数
	PageSize int32 `json:"page_size,optional"`
}

// ID query | ID 查询
type IDQuery {
	// ID | 主键
	Id int64 `form:"id" validate:"required,gt=0"`
}

// Base message | 结果信息
type BaseMsgResp {
	// Result | 结果信息
	Result string `json:"result"`
}